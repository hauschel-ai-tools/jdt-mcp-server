#!/bin/bash
#
# JDT MCP Server - Standalone launcher
# Starts the Eclipse JDT MCP server for use with AI coding assistants.
#
# Usage:
#   jdt-mcp          # stdio mode (default, for Claude Code)
#   jdt-mcp --http   # HTTP/SSE mode (for debugging)
#
# Environment variables:
#   JDTMCP_WORKSPACE  - Eclipse workspace directory (default: ~/.jdt-mcp/workspaces/<hash-of-cwd>)
#   JDTMCP_TRANSPORT  - Transport: stdio or http (default: stdio)
#   JDTMCP_VMARGS     - Additional JVM arguments (space-separated)
#   JAVA_HOME         - Java installation to use
#
# Configuration file:
#   ~/.jdt-mcp/jdt-mcp.ini - Additional JVM arguments (one per line, # for comments)
#
# Lombok support:
#   If lombok.jar exists in ~/.m2/repository, it is always loaded as -javaagent.
#   This is harmless for non-Lombok projects but essential for Lombok projects.
#   Set JDTMCP_NO_LOMBOK=1 to disable.
#

set -euo pipefail

# Resolve symlinks to find the real installation directory
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
    SCRIPT="$(readlink "$SCRIPT")"
done
BASEDIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

# Parse arguments
TRANSPORT="${JDTMCP_TRANSPORT:-stdio}"
for arg in "$@"; do
    case "$arg" in
        --version)
            VERSION_FILE="$BASEDIR/.version"
            if [ -f "$VERSION_FILE" ]; then
                echo "JDT MCP Server $(cat "$VERSION_FILE")"
            else
                echo "JDT MCP Server (development)"
            fi
            exit 0
            ;;
        --http) TRANSPORT="http" ;;
    esac
done

# Workspace directory - persistent per working directory
if [ -n "${JDTMCP_WORKSPACE:-}" ]; then
    WORKSPACE="$JDTMCP_WORKSPACE"
else
    if command -v md5sum >/dev/null 2>&1; then
        CWD_HASH=$(printf '%s' "$PWD" | md5sum | cut -d' ' -f1)
    else
        CWD_HASH=$(printf '%s' "$PWD" | md5 -q)
    fi
    WORKSPACE="$HOME/.jdt-mcp/workspaces/$CWD_HASH"
fi

# Find Java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA="java"
fi

# Find Equinox launcher
LAUNCHER=$(ls "$BASEDIR"/plugins/org.eclipse.equinox.launcher_*.jar 2>/dev/null | head -1)
if [ -z "$LAUNCHER" ]; then
    echo "ERROR: Equinox launcher not found in $BASEDIR/plugins/" >&2
    exit 1
fi

# Collect additional JVM arguments
EXTRA_VMARGS=()

# --- Lombok agent ---
# Always load Lombok if available in ~/.m2 — harmless for non-Lombok projects,
# but essential for Lombok projects. Avoids fragile project-level detection.
load_lombok() {
    if [ "${JDTMCP_NO_LOMBOK:-}" = "1" ]; then
        return
    fi

    local lombok_dir="$HOME/.m2/repository/org/projectlombok/lombok"
    if [ ! -d "$lombok_dir" ]; then
        return
    fi

    local lombok_jar
    lombok_jar=$(ls -t "$lombok_dir"/*/lombok-*.jar 2>/dev/null | head -1)

    if [ -n "$lombok_jar" ]; then
        echo "INFO: Loading Lombok agent: $lombok_jar" >&2
        EXTRA_VMARGS+=("-javaagent:$lombok_jar")
    fi
}

load_lombok

# --- Read ~/.jdt-mcp/jdt-mcp.ini ---
INI_FILE="$HOME/.jdt-mcp/jdt-mcp.ini"
if [ -f "$INI_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip empty lines and comments
        line="${line%%#*}"
        line="$(echo "$line" | xargs)" # trim whitespace
        if [ -n "$line" ]; then
            EXTRA_VMARGS+=("$line")
        fi
    done < "$INI_FILE"
fi

# --- Read JDTMCP_VMARGS environment variable ---
if [ -n "${JDTMCP_VMARGS:-}" ]; then
    # shellcheck disable=SC2206
    EXTRA_VMARGS+=($JDTMCP_VMARGS)
fi

# --- Process lifecycle ---
# The JVM runs as a background job in its own process group (set -m) so that a
# group-wide stop signal aimed at the client (Ctrl-Z, SIGTTOU) does not freeze it.
# The wrapper stays in the foreground to forward signals and to evaluate the exit
# code for workspace recovery. Without this, killing the wrapper leaves the JVM
# behind as an orphan holding ~1 GB (#80).
set -m

JAVA_PID=""
SIGNALLED=""

forward_signal() {
    local sig="$1"
    SIGNALLED="$sig"
    if [ -n "$JAVA_PID" ] && kill -0 "$JAVA_PID" 2>/dev/null; then
        # A stopped JVM cannot act on SIGTERM — resume it first
        kill -CONT "$JAVA_PID" 2>/dev/null || true
        kill -"$sig" "$JAVA_PID" 2>/dev/null || true
    fi
}
trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT
trap 'forward_signal HUP' HUP
trap 'forward_signal TERM' EXIT

run_server() {
    "$JAVA" \
        -Djdtmcp.headless=true \
        -Djdtmcp.transport="$TRANSPORT" \
        -Dosgi.bundles.defaultStartLevel=4 \
        -Declipse.application=org.naturzukunft.jdt.mcp.headless \
        "${EXTRA_VMARGS[@]+"${EXTRA_VMARGS[@]}"}" \
        -jar "$LAUNCHER" \
        -configuration "$BASEDIR/configuration" \
        -data "$WORKSPACE" \
        -nosplash \
        -clean \
        "$@" &
    JAVA_PID=$!

    # wait returns early when a trapped signal arrives; keep waiting until the
    # JVM is really gone so EXIT_CODE reflects its exit status.
    local code=0
    while true; do
        if wait "$JAVA_PID"; then code=0; else code=$?; fi
        kill -0 "$JAVA_PID" 2>/dev/null || break
    done
    return "$code"
}

# --- Launch with workspace recovery ---
# Recovery triggers when:
# 1. Server exits within 30 seconds (workspace likely corrupt), OR
# 2. Server exits with non-zero code AND log/stderr contains workspace corruption indicators
# Recovery deletes the workspace and retries once.
# A shutdown caused by the client (signal forwarded, or clean exit 0 after stdin
# closed) is never treated as corruption.
CWD_DIRNAME=$(basename "$PWD")
LOG_FILE="$HOME/.jdt-mcp/jdt-mcp-${CWD_DIRNAME}.log"

START_TIME=$(date +%s)
EXIT_CODE=0
run_server "$@" || EXIT_CODE=$?
END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

needs_recovery=false

if [ "${JDTMCP_RECOVERY:-}" = "1" ] || [ ! -d "$WORKSPACE" ]; then
    # Already in recovery mode or no workspace to delete
    needs_recovery=false
elif [ -n "$SIGNALLED" ] || [ "$EXIT_CODE" -eq 0 ]; then
    # Client-initiated shutdown — nothing to recover
    needs_recovery=false
elif [ "$ELAPSED" -lt 30 ]; then
    # Quick failure — workspace likely corrupt
    needs_recovery=true
elif [ -f "$LOG_FILE" ]; then
    # Check log for known workspace corruption errors
    if tail -50 "$LOG_FILE" | grep -qE "ObjectNotFoundException|Tree element.*not found|MCP server failed to start"; then
        needs_recovery=true
    fi
fi

if [ "$needs_recovery" = true ]; then
    echo "WARNING: Server exited after ${ELAPSED}s (exit code $EXIT_CODE) — workspace corrupt, deleting and retrying..." >&2
    rm -rf "$WORKSPACE"
    trap - EXIT
    JDTMCP_RECOVERY=1 exec "$0" "$@"
fi

trap - EXIT
exit "$EXIT_CODE"
